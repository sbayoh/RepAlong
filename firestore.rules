rules_version = '2';

// Phase 1A — private account-foundation data. Phase 2A adds `profiles/{uid}`, the
// profile foundation.
//
// `users/{uid}` is PRIVATE account data (identity/contact/status), never a
// public/discoverable profile. `profiles/{uid}` (Phase 2A) is the future-discoverable
// profile document, but stays owner-readable-only for now — public visibility is a
// deliberate, separately reviewed decision for the discovery phase, not a byproduct of
// this schema. Neither document is readable by anyone but its owner. See
// docs/architecture.md.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) && isValidNewUserDoc(userId);

      allow update: if isOwner(userId) && isValidUserUpdate();

      allow delete: if false;
    }

    match /profiles/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) && isValidNewProfileDoc(userId);

      allow update: if isOwner(userId) && isValidProfileUpdate();

      allow delete: if false;
    }

    // Default-deny: every other path is inaccessible until a later phase
    // explicitly opens it.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  function userDocFields() {
    return [
      'uid', 'email', 'firstName', 'lastName', 'displayName',
      'createdAt', 'updatedAt', 'onboardingCompleted', 'accountStatus',
    ];
  }

  // New documents may only be created with the caller's own uid, a fresh
  // server-resolved createdAt/updatedAt (so clients can't backdate them),
  // and accountStatus fixed to 'active' — a client can never self-create as
  // e.g. 'suspended'.
  function isValidNewUserDoc(userId) {
    let incoming = request.resource.data;
    return incoming.uid == userId
      && incoming.email is string
      && incoming.firstName is string
      && incoming.lastName is string
      && incoming.displayName is string
      && incoming.onboardingCompleted == false
      && incoming.accountStatus == 'active'
      && incoming.createdAt == request.time
      && incoming.updatedAt == request.time
      && incoming.keys().hasOnly(userDocFields());
  }

  // Updates may only touch name/onboarding fields. uid, email, createdAt,
  // and accountStatus are fixed post-creation from the client's perspective
  // — accountStatus can only change later via a trusted server path (e.g. a
  // future Cloud Function), which does not exist yet in this phase.
  function isValidUserUpdate() {
    let incoming = request.resource.data;
    let existing = resource.data;
    return incoming.uid == existing.uid
      && incoming.email == existing.email
      && incoming.createdAt == existing.createdAt
      && incoming.accountStatus == existing.accountStatus
      && incoming.updatedAt == request.time
      && incoming.firstName is string
      && incoming.lastName is string
      && incoming.displayName is string
      && incoming.onboardingCompleted is bool
      && incoming.keys().hasOnly(userDocFields());
  }

  function profileDocFields() {
    return [
      'uid', 'displayName', 'firstName', 'lastName', 'bio', 'experienceLevel',
      'goals', 'trainingInterests', 'trainingVibes', 'interestedInHosting',
      'photoURL', 'createdAt', 'updatedAt',
    ];
  }

  function isValidExperienceLevel(level) {
    return level in ['beginner', 'intermediate', 'experienced'];
  }

  function allowedGoals() {
    return [
      'build_strength', 'build_muscle', 'fat_loss', 'general_fitness',
      'endurance', 'athletic_performance', 'learn_the_gym', 'stay_consistent',
    ];
  }

  function allowedTrainingInterests() {
    return [
      'strength_training', 'bodybuilding', 'powerlifting', 'functional_fitness',
      'cardio', 'hiit', 'mobility', 'calisthenics', 'sports_training',
    ];
  }

  function allowedTrainingVibes() {
    return ['focused', 'social', 'beginner_friendly', 'high_energy', 'relaxed', 'accountability'];
  }

  // Every entry must be one of `allowed`, and no entry may repeat. `toSet()` collapses
  // duplicates, so a size mismatch against the original list means the list had at
  // least one repeat.
  function isValidEnumArray(items, allowed) {
    return items.hasOnly(allowed) && items.size() == items.toSet().size();
  }

  // Shared field-shape checks that don't change between create and update: string
  // types/length caps, array type/size caps + allow-listed unique enum values,
  // interestedInHosting/photoURL types. Bounds are upper-only here — "require at
  // least one goal", "1–3 vibes", etc. are onboarding-flow UX rules
  // (src/features/onboarding/validation.ts), not identity invariants a security rule
  // should also gatekeep.
  function hasValidProfileFieldShapes(incoming) {
    return incoming.displayName is string && incoming.displayName.size() <= 60
      && incoming.firstName is string && incoming.firstName.size() <= 60
      && incoming.lastName is string && incoming.lastName.size() <= 60
      && incoming.bio is string && incoming.bio.size() <= 300
      && isValidExperienceLevel(incoming.experienceLevel)
      && incoming.goals is list && incoming.goals.size() <= 8
      && isValidEnumArray(incoming.goals, allowedGoals())
      && incoming.trainingInterests is list && incoming.trainingInterests.size() <= 9
      && isValidEnumArray(incoming.trainingInterests, allowedTrainingInterests())
      && incoming.trainingVibes is list && incoming.trainingVibes.size() <= 3
      && isValidEnumArray(incoming.trainingVibes, allowedTrainingVibes())
      && incoming.interestedInHosting is bool
      && (incoming.photoURL == null || incoming.photoURL is string);
  }

  // New profiles may only be created by their owner, with the caller's own uid, a
  // fresh server-resolved createdAt/updatedAt, and exactly the expected key set.
  function isValidNewProfileDoc(userId) {
    let incoming = request.resource.data;
    return incoming.uid == userId
      && hasValidProfileFieldShapes(incoming)
      && incoming.createdAt == request.time
      && incoming.updatedAt == request.time
      && incoming.keys().hasOnly(profileDocFields());
  }

  // Updates may only touch the editable profile fields. uid and createdAt are
  // immutable post-creation.
  function isValidProfileUpdate() {
    let incoming = request.resource.data;
    let existing = resource.data;
    return incoming.uid == existing.uid
      && incoming.createdAt == existing.createdAt
      && incoming.updatedAt == request.time
      && hasValidProfileFieldShapes(incoming)
      && incoming.keys().hasOnly(profileDocFields());
  }
}
