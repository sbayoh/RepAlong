{
  "expo": {
    "name": "RepAlong",
    "slug": "repalong",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/repalong-app-icon.png",
    "scheme": "repalong",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.techden.repalong",
      "icon": "./assets/brand/repalong-app-icon.png"
    },
    "android": {
      "package": "com.techden.repalong",
      "adaptiveIcon": {
        "backgroundColor": "#0F3D2E",
        "foregroundImage": "./assets/brand/repalong-app-icon-foreground.png",
        "monochromeImage": "./assets/brand/repalong-app-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/repalong-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F3D2E",
          "image": "./assets/brand/repalong-splash.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
