# Firebase Web app config (repalong-49bc9 > RepAlong Web).
# These are client-public values that ship inside the app bundle — they are
# not secrets, but are still kept out of source and out of git so each
# environment (local, EAS builds, CI) supplies its own copy.
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time by Expo.
# Copy this file to .env and fill in real values from:
# Firebase Console > Project Settings > Your apps > RepAlong Web > SDK setup and configuration

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional: set to "true" to route Auth/Firestore at the local Firebase
# Emulator Suite (see docs/architecture.md) instead of production Firebase.
# Leave unset/false for normal development against the real project.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=
